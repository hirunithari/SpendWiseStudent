<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Statistics"
            android:textColor="#111827"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatisticsMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="August 2026"
            android:textColor="#7C8494"
            android:textSize="14sp" />


        <!-- This Month -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPENT THIS MONTH"
                android:textColor="#8A94A6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvStatisticsMonthlySpent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="LKR 0.00"
                android:textColor="#2563EB"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Remaining Budget -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REMAINING BUDGET"
                android:textColor="#8A94A6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatisticsRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Not set"
                android:textColor="#111827"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- All Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL SPENT"
                android:textColor="#8A94A6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatisticsTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="LKR 0.00"
                android:textColor="#111827"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Expense Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPENSE RECORDS"
                android:textColor="#8A94A6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatisticsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0 expenses"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Highest Expense -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGHEST EXPENSE"
                android:textColor="#8A94A6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatisticsHighest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="No expenses"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Top Category -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOP CATEGORY"
                android:textColor="#8A94A6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatisticsCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="No data"
                android:textColor="#2563EB"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>


        <Button
            android:id="@+id/btnBackStatistics"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#E8EEFF"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="#2558C9"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>